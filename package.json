{
  "name": "lookiva",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "echo \"no integration tests yet\"",
    "test:e2e": "echo \"no e2e tests yet\"",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "infra:up": "docker compose --env-file .env.example -f compose.yaml -f compose.test.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env.example -f compose.yaml -f compose.test.yaml down -v",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.json"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
