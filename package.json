{
  "name": "lookiva",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:generate && next build",
    "lint": "pnpm db:generate && eslint .",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "vitest run",
    "test:int": "pnpm db:generate && vitest run --config vitest.int.config.ts",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "verify": "bash scripts/verify.sh",
    "secrets:scan": "secretlint \"**/*\"",
    "stack:up": "docker compose --env-file .env.example --profile app up -d --build --wait",
    "stack:down": "docker compose --env-file .env.example --profile app down",
    "stack:reset": "docker compose --env-file .env.example --profile app down -v",
    "infra:up": "docker compose --env-file .env.example -f compose.yaml -f compose.test.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env.example -f compose.yaml -f compose.test.yaml down",
    "infra:reset": "docker compose --env-file .env.example -f compose.yaml -f compose.test.yaml down -v",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs --ts-config tsconfig.json",
    "build:worker": "esbuild src/worker/main.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outfile=dist/worker.js",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "openapi:bundle": "esbuild scripts/gen-openapi.ts --bundle --packages=external --platform=node --format=esm --target=node24 --log-level=warning --outfile=dist/gen-openapi.mjs",
    "openapi:gen": "pnpm openapi:bundle && node dist/gen-openapi.mjs",
    "openapi:check": "pnpm openapi:bundle && node dist/gen-openapi.mjs --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "4.3.3",
    "bullmq": "6.5.0",
    "ioredis": "6.0.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prisma": "7.10.1",
    "secretlint": "13.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
