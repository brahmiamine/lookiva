generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model IdempotencyRecord {
  id           String   @id @db.Char(36)
  userId       String   @db.VarChar(64)
  key          String   @db.VarChar(255)
  requestHash  String   @db.Char(64)
  status       Int // 0 = pending
  responseBody Json?
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@unique([userId, key])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------- identity (phase 03)

enum UserStatus {
  ACTIVE
  DISABLED
  DELETION_REQUESTED
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum Locale {
  fr
  en
  ar
}

enum ThermalSensitivity {
  COLD
  NEUTRAL
  WARM
}

model User {
  id              String     @id @db.Char(36)
  email           String     @db.VarChar(254)
  /// NFKC + trim + lowercase; the only column used for lookups and uniqueness.
  emailNormalized String     @unique @db.VarChar(254)
  emailVerifiedAt DateTime?  @db.DateTime(3)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @db.DateTime(3)
  updatedAt       DateTime   @updatedAt @db.DateTime(3)
  version         Int        @default(1)

  credential          Credential?
  tokens              EmailToken[]
  sessions            SessionRegistry[]
  preferences         UserPreferences?
  consents            ConsentRecord[]
  deletionRequests    DeletionRequest[]
  exportRequests      ExportRequest[]
  garments            Garment[]
  customSubcategories CustomSubcategory[]
  tags                Tag[]
  collections         Collection[]
  garmentSets         GarmentSet[]
  outfits             Outfit[]
  outfitTemplates     OutfitTemplate[]
  wearRecords         WearRecord[]
  recoSessions        RecommendationSession[]
  recoFeedback        RecommendationFeedback[]
  weatherBaselines    OutfitWeatherBaseline[]

  @@map("users")
}

model Credential {
  userId       String   @id @db.Char(36)
  passwordHash String   @db.VarChar(255)
  updatedAt    DateTime @db.DateTime(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model EmailToken {
  id                  String            @id @db.Char(36)
  userId              String            @db.Char(36)
  purpose             EmailTokenPurpose
  tokenHash           String            @unique @db.Char(64)
  createdAt           DateTime          @db.DateTime(3)
  expiresAt           DateTime          @db.DateTime(3)
  usedAt              DateTime?         @db.DateTime(3)
  /// VERIFY_EMAIL from a registration only: scrypt hash of the password typed at that registration, applied to the
  /// credential when THIS link is used (so whoever controls the mailbox decides the password). Cleared on use.
  pendingPasswordHash String?           @db.VarChar(255)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("email_tokens")
}

model SessionRegistry {
  id         String    @id @db.Char(36)
  userId     String    @db.Char(36)
  tokenHash  String    @unique @db.Char(64)
  userAgent  String    @db.VarChar(255)
  createdAt  DateTime  @db.DateTime(3)
  lastSeenAt DateTime  @db.DateTime(3)
  expiresAt  DateTime  @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("session_registry")
}

model UserPreferences {
  userId                String             @id @db.Char(36)
  locale                Locale             @default(fr)
  cityName              String?            @db.VarChar(120)
  countryCode           String?            @db.Char(2)
  latitude              Decimal?           @db.Decimal(9, 6)
  longitude             Decimal?           @db.Decimal(9, 6)
  timezone              String?            @db.VarChar(64)
  aiEnabled             Boolean            @default(false)
  learningEnabled       Boolean            @default(false)
  thermalSensitivity    ThermalSensitivity @default(NEUTRAL)
  /// Opt-in: recommendation feedback may influence ranking (phase 06).
  personalization       Boolean            @default(false)
  onboardingCompletedAt DateTime?          @db.DateTime(3)
  version               Int                @default(1)
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model ConsentRecord {
  id        String   @id @db.Char(36)
  userId    String   @db.Char(36)
  kind      String   @db.VarChar(32)
  granted   Boolean
  createdAt DateTime @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@map("consent_records")
}

enum DeletionRequestStatus {
  PENDING
  CANCELLED
}

enum ExportRequestStatus {
  PENDING
}

/// Preparatory only (plans/03 T10): nothing is purged or exported yet, backups are never promised purged.
model DeletionRequest {
  id             String                @id @db.Char(36)
  userId         String                @db.Char(36)
  status         DeletionRequestStatus @default(PENDING)
  /// Account status to restore if the request is cancelled.
  previousStatus UserStatus
  requestedAt    DateTime              @db.DateTime(3)
  cancelledAt    DateTime?             @db.DateTime(3)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("deletion_requests")
}

model ExportRequest {
  id          String              @id @db.Char(36)
  userId      String              @db.Char(36)
  status      ExportRequestStatus @default(PENDING)
  requestedAt DateTime            @db.DateTime(3)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@map("export_requests")
}

/// Dev/test email transport (EMAIL_TRANSPORT=outbox). Holds plaintext links: never enabled in production.
model OutboxMessage {
  id        String   @id @db.Char(36)
  to        String   @db.VarChar(254)
  subject   String   @db.VarChar(255)
  text      String   @db.Text
  createdAt DateTime @db.DateTime(3)

  @@index([to, createdAt])
  @@map("outbox_messages")
}

// ---------------------------------------------------------------- wardrobe (phase 04)
// Status, weather fields, categories, colors... are VarChar validated by the domain constants (src/modules/wardrobe/domain),
// not DB enums: changing a list never needs a migration.

model CustomSubcategory {
  id                String    @id @db.Char(36)
  ownerId           String    @db.Char(36)
  label             String    @db.VarChar(60)
  /// NFKC + trim + lowercase of label; the unique key per owner.
  labelNormalized   String    @db.VarChar(60)
  /// Standard subtype this custom one specialises (its category is derived from the catalog).
  parentSubtypeCode String    @db.VarChar(48)
  version           Int       @default(1)
  createdAt         DateTime  @db.DateTime(3)
  updatedAt         DateTime  @db.DateTime(3)
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  garments          Garment[]

  @@unique([ownerId, labelNormalized])
  @@map("custom_subcategories")
}

model Garment {
  id                  String               @id @db.Char(36)
  ownerId             String               @db.Char(36)
  nickname            String?              @db.VarChar(80)
  categoryCode        String               @db.VarChar(32)
  /// Exactly one of subtypeCode / customSubcategoryId is set.
  subtypeCode         String?              @db.VarChar(48)
  customSubcategoryId String?              @db.Char(36)
  primaryColorCode    String               @db.VarChar(24)
  primaryShade        String?              @db.VarChar(16)
  purchasePrice       Decimal?             @db.Decimal(10, 2)
  purchaseCurrency    String?              @db.Char(3)
  purchasedOn         DateTime?            @db.Date
  purchaseStore       String?              @db.VarChar(120)
  notes               String?              @db.VarChar(2000)
  warmth              String               @default("UNKNOWN") @db.VarChar(16)
  rain                String               @default("UNKNOWN") @db.VarChar(16)
  windproof           String               @default("UNKNOWN") @db.VarChar(16)
  breathability       String               @default("UNKNOWN") @db.VarChar(16)
  layering            String               @default("UNKNOWN") @db.VarChar(16)
  status              String               @default("AVAILABLE") @db.VarChar(16)
  version             Int                  @default(1)
  /// Soft delete (trash): purgeAfter = deletedAt + 30 days.
  deletedAt           DateTime?            @db.DateTime(3)
  purgeAfter          DateTime?            @db.DateTime(3)
  createdAt           DateTime             @db.DateTime(3)
  updatedAt           DateTime             @db.DateTime(3)
  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customSubcategory   CustomSubcategory?   @relation(fields: [customSubcategoryId], references: [id], onDelete: Restrict)
  colors              GarmentColor[]
  seasons             GarmentSeason[]
  styles              GarmentStyle[]
  statusEvents        GarmentStatusEvent[]
  photos              GarmentPhoto[]
  tagLinks            GarmentTag[]
  collectionLinks     CollectionGarment[]
  setItems            GarmentSetItem[]
  outfitItems         OutfitItem[]
  templateItems       OutfitTemplateItem[]
  wearItems           WearRecordItem[]

  @@index([ownerId, deletedAt, id])
  @@index([ownerId, status])
  @@index([ownerId, categoryCode])
  @@index([customSubcategoryId])
  @@index([purgeAfter])
  @@map("garments")
}

/// Extra (non primary) colors of a garment.
model GarmentColor {
  garmentId String  @db.Char(36)
  position  Int
  colorCode String  @db.VarChar(24)
  shade     String? @db.VarChar(16)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@id([garmentId, position])
  @@index([colorCode])
  @@map("garment_colors")
}

model GarmentSeason {
  garmentId String  @db.Char(36)
  code      String  @db.VarChar(16)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@id([garmentId, code])
  @@map("garment_seasons")
}

model GarmentStyle {
  garmentId String  @db.Char(36)
  code      String  @db.VarChar(24)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@id([garmentId, code])
  @@map("garment_styles")
}

/// Append-only status history (the current status lives on Garment; both change in one transaction).
model GarmentStatusEvent {
  id         String   @id @db.Char(36)
  garmentId  String   @db.Char(36)
  ownerId    String   @db.Char(36)
  fromStatus String?  @db.VarChar(16)
  toStatus   String   @db.VarChar(16)
  source     String   @default("MANUAL") @db.VarChar(16)
  note       String?  @db.VarChar(500)
  at         DateTime @db.DateTime(3)
  garment    Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([garmentId, id])
  @@map("garment_status_events")
}

/// Photo of a garment. The three storage keys are private object keys; rows of the same owner MAY share keys after a
/// duplication, so an object is deleted only when no row references its key any more.
model GarmentPhoto {
  id           String   @id @db.Char(36)
  garmentId    String   @db.Char(36)
  ownerId      String   @db.Char(36)
  position     Int
  /// 1 for the primary photo, NULL otherwise: the unique index makes "exactly one primary" a database guarantee.
  primarySlot  Int?
  originalKey  String   @db.VarChar(255)
  optimizedKey String   @db.VarChar(255)
  thumbKey     String   @db.VarChar(255)
  cutoutKey    String?  @db.VarChar(255)
  /// READY | FAILED | NULL (never requested).
  cutoutStatus String?  @db.VarChar(8)
  mime         String   @db.VarChar(32)
  bytes        Int
  width        Int
  height       Int
  sha256       String   @db.Char(64)
  createdAt    DateTime @db.DateTime(3)
  garment      Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, position])
  @@unique([garmentId, primarySlot])
  @@index([ownerId])
  @@index([originalKey])
  @@index([optimizedKey])
  @@index([thumbKey])
  @@index([cutoutKey])
  @@map("garment_photos")
}

/// Phase 04 slice 4c: tags, collections and garment sets. Owner scoped, independent from outfits.

model Tag {
  id              String       @id @db.Char(36)
  ownerId         String       @db.Char(36)
  label           String       @db.VarChar(40)
  labelNormalized String       @db.VarChar(40)
  version         Int          @default(1)
  createdAt       DateTime     @db.DateTime(3)
  updatedAt       DateTime     @db.DateTime(3)
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items           GarmentTag[]

  @@unique([ownerId, labelNormalized])
  @@map("tags")
}

/// Ordered membership; links vanish with the group or when the garment is purged (a trashed garment stays linked).
model GarmentTag {
  tagId     String  @db.Char(36)
  garmentId String  @db.Char(36)
  position  Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@id([tagId, garmentId])
  @@index([garmentId])
  @@map("garment_tags")
}

model Collection {
  id             String              @id @db.Char(36)
  ownerId        String              @db.Char(36)
  name           String              @db.VarChar(60)
  nameNormalized String              @db.VarChar(60)
  version        Int                 @default(1)
  createdAt      DateTime            @db.DateTime(3)
  updatedAt      DateTime            @db.DateTime(3)
  owner          User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items          CollectionGarment[]

  @@unique([ownerId, nameNormalized])
  @@map("collections")
}

/// Ordered membership; links vanish with the group or when the garment is purged (a trashed garment stays linked).
model CollectionGarment {
  collectionId String     @db.Char(36)
  garmentId    String     @db.Char(36)
  position     Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  garment      Garment    @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@id([collectionId, garmentId])
  @@index([garmentId])
  @@map("collection_garments")
}

model GarmentSet {
  id             String           @id @db.Char(36)
  ownerId        String           @db.Char(36)
  name           String           @db.VarChar(60)
  nameNormalized String           @db.VarChar(60)
  version        Int              @default(1)
  createdAt      DateTime         @db.DateTime(3)
  updatedAt      DateTime         @db.DateTime(3)
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items          GarmentSetItem[]

  @@unique([ownerId, nameNormalized])
  @@map("garment_sets")
}

/// Ordered membership; links vanish with the group or when the garment is purged (a trashed garment stays linked).
model GarmentSetItem {
  setId     String     @db.Char(36)
  garmentId String     @db.Char(36)
  position  Int
  set       GarmentSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  garment   Garment    @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@id([setId, garmentId])
  @@index([garmentId])
  @@map("garment_set_items")
}

// ---- Phase 05: outfits, templates, wear records. Planning (Outfit) is separate from usage (WearRecord) and current state (Garment.status).

/// startsAt/endsAt are UTC; localDate/localTime/timezone (IANA) are the user's wall clock at the start (derived by the server). A DRAFT may lack all of them.
model Outfit {
  id              String                 @id @db.Char(36)
  ownerId         String                 @db.Char(36)
  title           String?                @db.VarChar(120)
  /// DRAFT | PLANNED | WORN | CANCELLED
  status          String                 @default("DRAFT") @db.VarChar(12)
  occasion        String?                @db.VarChar(80)
  startsAt        DateTime?              @db.DateTime(3)
  endsAt          DateTime?              @db.DateTime(3)
  localDate       DateTime?              @db.Date
  localTime       String?                @db.VarChar(5)
  timezone        String?                @db.VarChar(64)
  version         Int                    @default(1)
  createdAt       DateTime               @db.DateTime(3)
  updatedAt       DateTime               @db.DateTime(3)
  owner           User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items           OutfitItem[]
  wearRecords     WearRecord[]
  weatherBaseline OutfitWeatherBaseline?

  @@index([ownerId, localDate, startsAt])
  @@index([ownerId, status])
  @@map("outfits")
}

model OutfitItem {
  id        String  @id @db.Char(36)
  outfitId  String  @db.Char(36)
  garmentId String  @db.Char(36)
  role      String  @db.VarChar(12)
  position  Int
  outfit    Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([outfitId, garmentId])
  @@index([garmentId])
  @@map("outfit_items")
}

model OutfitTemplate {
  id        String               @id @db.Char(36)
  ownerId   String               @db.Char(36)
  name      String               @db.VarChar(80)
  occasion  String?              @db.VarChar(80)
  version   Int                  @default(1)
  createdAt DateTime             @db.DateTime(3)
  updatedAt DateTime             @db.DateTime(3)
  owner     User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items     OutfitTemplateItem[]

  @@index([ownerId, id])
  @@map("outfit_templates")
}

model OutfitTemplateItem {
  id         String         @id @db.Char(36)
  templateId String         @db.Char(36)
  garmentId  String         @db.Char(36)
  role       String         @db.VarChar(12)
  position   Int
  template   OutfitTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  garment    Garment        @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([templateId, garmentId])
  @@index([garmentId])
  @@map("outfit_template_items")
}

/// activeSlot is 1 while ACTIVE and NULL once INVALIDATED: UNIQUE(outfitId, activeSlot) = at most one active record per outfit.
model WearRecord {
  id                 String           @id @db.Char(36)
  ownerId            String           @db.Char(36)
  outfitId           String           @db.Char(36)
  title              String?          @db.VarChar(120)
  occasion           String?          @db.VarChar(80)
  /// ACTIVE | INVALIDATED
  status             String           @default("ACTIVE") @db.VarChar(12)
  activeSlot         Int?
  confirmedAt        DateTime         @db.DateTime(3)
  localDate          DateTime         @db.Date
  localTime          String           @db.VarChar(5)
  timezone           String           @db.VarChar(64)
  version            Int              @default(1)
  invalidatedAt      DateTime?        @db.DateTime(3)
  invalidationReason String?          @db.VarChar(500)
  createdAt          DateTime         @db.DateTime(3)
  owner              User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  outfit             Outfit           @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  items              WearRecordItem[]

  @@unique([outfitId, activeSlot])
  @@index([ownerId, status, confirmedAt])
  @@map("wear_records")
}

/// Immutable snapshot of one worn garment. No photo reference. garmentId becomes NULL when the garment is purged.
model WearRecordItem {
  id                 String     @id @db.Char(36)
  wearRecordId       String     @db.Char(36)
  garmentId          String?    @db.Char(36)
  role               String     @db.VarChar(12)
  position           Int
  nickname           String?    @db.VarChar(80)
  categoryCode       String     @db.VarChar(32)
  subtypeCode        String?    @db.VarChar(48)
  customSubtypeLabel String?    @db.VarChar(60)
  primaryColorCode   String     @db.VarChar(24)
  extraColorCodes    Json
  wearRecord         WearRecord @relation(fields: [wearRecordId], references: [id], onDelete: Cascade)
  garment            Garment?   @relation(fields: [garmentId], references: [id], onDelete: SetNull)

  @@index([wearRecordId])
  @@index([garmentId])
  @@map("wear_record_items")
}

/// Phase 06. Cached normalized forecast of one place and local day (location key = rounded lat,lon). Append-only, purged after 7 days.
model WeatherSnapshot {
  id          String   @id @db.Char(36)
  locationKey String   @db.VarChar(24)
  localDate   String   @db.Char(10)
  provider    String   @db.VarChar(32)
  /// When the provider issued the forecast.
  issuedAt    DateTime @db.DateTime(3)
  fetchedAt   DateTime @db.DateTime(3)
  timezone    String   @db.VarChar(64)
  /// Normalized hourly periods: { hour, tempC, feelsLikeC, precipProbability, windKph, reliability }[]
  payload     Json

  @@index([locationKey, localDate, fetchedAt])
  @@index([fetchedAt])
  @@map("weather_snapshots")
}

/// Phase 06. Only fingerprints (hashes of sorted garment ids) already shown: powers "another proposal". Proposals themselves are never stored.
model RecommendationSession {
  id           String   @id @db.Char(36)
  ownerId      String   @db.Char(36)
  fingerprints Json
  createdAt    DateTime @db.DateTime(3)
  expiresAt    DateTime @db.DateTime(3)
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, expiresAt])
  @@map("recommendation_sessions")
}

/// Phase 06. ACCEPT | REJECT | MODIFY. garmentIds is an id snapshot (no FK: history survives garment purge). Deletable on its own.
model RecommendationFeedback {
  id          String   @id @db.Char(36)
  ownerId     String   @db.Char(36)
  sessionId   String?  @db.Char(36)
  fingerprint String   @db.Char(64)
  action      String   @db.VarChar(8)
  garmentIds  Json
  createdAt   DateTime @db.DateTime(3)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("recommendation_feedback")
}

/// Phase 06. The forecast an outfit was planned against (copied payload), compared later with a fresh one. Never changes the outfit.
model OutfitWeatherBaseline {
  outfitId  String   @id @db.Char(36)
  ownerId   String   @db.Char(36)
  latitude  Float
  longitude Float
  timezone  String   @db.VarChar(64)
  localDate String   @db.Char(10)
  fromHour  Int
  toHour    Int
  provider  String   @db.VarChar(32)
  issuedAt  DateTime @db.DateTime(3)
  payload   Json
  createdAt DateTime @db.DateTime(3)
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("outfit_weather_baselines")
}
