# Placeholders only. Copy to .env and replace; never commit real secrets.
NODE_ENV=development
DATABASE_URL=mysql://lookiva:change-me@127.0.0.1:3307/lookiva
REDIS_URL=redis://127.0.0.1:6380
READY_TOKEN=change-me
LOG_LEVEL=info
# true only behind exactly one reverse proxy that appends the client address to X-Forwarded-For
TRUST_PROXY=false
# outbox (dev/test: mails stored in the outbox_messages table) | none. Production: explicit, outbox refused.
EMAIL_TRANSPORT=outbox
# Public origin: the ONLY base of links in emails and the expected Origin of CSRF checks.
# Required in production and whenever EMAIL_TRANSPORT is not none.
APP_ORIGIN=http://localhost:3000
# Private directory of the local object storage (photos): never under public/, never served statically, git-ignored.
STORAGE_LOCAL_DIR=./.storage
# READY_TOKEN for the compose containers (NODE_ENV=production needs 32+ chars and no change-me). Local placeholder only:
# this public value is knowingly accepted by the production rules, never use it outside a developer machine.
STACK_READY_TOKEN=local-stack-only-placeholder-not-a-secret

# Local compose (MariaDB + Redis)
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=lookiva
MARIADB_USER=lookiva
MARIADB_PASSWORD=change-me
DB_HOST_PORT=3307
REDIS_HOST_PORT=6380
WEB_HOST_PORT=3000
